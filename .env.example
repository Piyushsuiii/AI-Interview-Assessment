# ==========================================
# AI Hiring Intelligence Platform - Env Vars
# ==========================================

# --- Environment ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL via Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_hiring_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_hiring_platform?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=2

# --- Authentication ---
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-char-secret"
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"
COOKIE_DOMAIN=

# Google OAuth (server only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Transactional email (server only; required in production)
RESEND_API_KEY=""
MAIL_FROM="AI Hiring <accounts@example.com>"

# --- Stripe Billing (server only) ---
# Leave all values empty to run safely without billing actions.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ENTERPRISE=""

# --- Object Storage (MinIO / S3) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="hiring-platform-storage"

# --- AI Providers ---
# OpenAI
OPENAI_API_KEY=""
# Gemini
GEMINI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_MODEL="gemini-2.0-flash"
AI_PRIMARY_PROVIDER="openai"

# --- Frontend specific ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
